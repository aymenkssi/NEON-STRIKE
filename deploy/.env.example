# --- Choix de la pile ---
# Serveur qui a déjà Traefik : décommentez la ligne suivante (sinon : pile autonome avec Caddy).
# COMPOSE_FILE=docker-compose.traefik.yml

# Domaines pointant vers l'IP du VPS (enregistrements DNS A pour api, @ et www)
DOMAIN=api.gameneonstrike.com
SITE_DOMAIN=gameneonstrike.com

# Identifiants MongoDB (choisir un mot de passe long, ex. `openssl rand -hex 24`)
MONGO_USER=neon
MONGO_PASSWORD=change-me

# Jeton de la page d'administration https://api.gameneonstrike.com/admin
# (au moins 16 caractères, ex. `openssl rand -hex 32`). Vide = administration désactivée.
ADMIN_TOKEN=

# "google" en production. "disabled" accepte les achats sans vérification (tests uniquement).
PURCHASE_VERIFICATION=google
GOOGLE_PLAY_PACKAGE=com.aymenkssi.neonstrike

# --- Traefik existant (uniquement avec docker-compose.traefik.yml) ---
# Réseau Docker auquel Traefik est connecté (`docker network ls`)
TRAEFIK_NETWORK=traefik
# Nom de l'entrypoint HTTPS dans la configuration de Traefik (souvent websecure ou https)
TRAEFIK_ENTRYPOINT=websecure
# Nom du certresolver Let's Encrypt dans la configuration de Traefik (souvent letsencrypt ou le)
TRAEFIK_CERTRESOLVER=letsencrypt
