# Nom de domaine pointant vers l'IP du VPS (enregistrement DNS A), ex. api.neonstrike.fr
DOMAIN=api.example.com

# Identifiants MongoDB (choisir un mot de passe long, ex. `openssl rand -hex 24`)
MONGO_USER=neon
MONGO_PASSWORD=change-me

# "google" en production. "disabled" accepte les achats sans vérification (tests uniquement).
PURCHASE_VERIFICATION=google
GOOGLE_PLAY_PACKAGE=com.aymenkssi.neonstrike
