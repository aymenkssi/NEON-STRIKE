# Copier ce fichier en `.env` puis adapter les valeurs.
# Sur un téléphone/émulateur, "localhost" ne pointe PAS vers votre PC :
#  - Émulateur Android : http://10.0.2.2:8001
#  - Téléphone physique (même Wi-Fi) : http://<IP-locale-du-PC>:8001
#  - Serveur de production : https://api.votre-domaine.fr (voir deploy/README.md)
# Sans cette variable, le classement est indisponible et les achats sont crédités sans vérification.
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:8001

# "test" (défaut) = publicités de test Google ; "production" = vraies unités NEON STRIKE
# (déjà renseignées dans src/ads/index.ts, activées automatiquement par le profil EAS "production").
# Ne jamais utiliser "production" sur votre propre téléphone : cliquer ses propres pubs peut faire suspendre le compte AdMob.
EXPO_PUBLIC_AD_MODE=test
# Facultatif : remplacer les unités d'annonces par défaut
# EXPO_PUBLIC_BANNER_AD_UNIT=ca-app-pub-7488746561313974/5771431884
# EXPO_PUBLIC_INTERSTITIAL_AD_UNIT=ca-app-pub-7488746561313974/3145268547
# EXPO_PUBLIC_REWARDED_AD_UNIT=ca-app-pub-7488746561313974/9864036785
