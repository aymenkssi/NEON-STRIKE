# Copier ce fichier en `.env` pour lancer l'API en local (hors Docker).
MONGO_URL=mongodb://localhost:27017
DB_NAME=neon_strike

# Vérification des achats Google Play : "google" (production) ou "disabled" (dev local uniquement).
PURCHASE_VERIFICATION=disabled
GOOGLE_PLAY_PACKAGE=com.aymenkssi.neonstrike
# Clé JSON du compte de service Google Cloud (voir deploy/README.md)
# GOOGLE_SERVICE_ACCOUNT_FILE=/chemin/vers/play-service-account.json
